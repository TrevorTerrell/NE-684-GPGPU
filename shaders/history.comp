#version 450

#define ENERGY_MIN 1e-5
#define ENERGY_MAX 2e7
#define XSEC_COLUMNS 7
#define ENERGY_POINTS 10000

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufferXSec { float data[]; } XSec;
layout(set = 0, binding = 1, std430) writeonly buffer BufferTally {float data[]; } Tally;

layout(push_constant) uniform Parameters {
    uint seed;
    uint neutronCount;
    float rouletteThreshold;
    float rouletteLiveRate;
} params;

struct Neutron {
    float energy;
    float weight;
};

struct CrossSections {
    float U_Fiss;
    float U_Cap;
    float U_Scat;
    float Pu_Fiss;
    float Pu_Cap;
    float Pu_Scat;
    float C_Scat;
    float Total;
};

float getCrossSection(uint index, float fraction, uint column){
    return XSec.data[index * XSEC_COLUMNS + column] * (1.0 - fraction) +
        XSec.data[(index + 1) * XSEC_COLUMNS + column] * fraction;
}

CrossSections interpolateCrossSections(Neutron neutron){
    CrossSections xs;
    const float logEmax = 16.8112483; // log(ENERGY_MAX)
    const float logEmin = -11.5129254; // log(ENERGY_MIN)
    const float delta_logE = (logEmax - logEmin) / float(ENERGY_POINTS - 1);

    const float position = (log(neutron.energy) - logEmin) / delta_logE;
    const uint index = int(floor(position));
    const float frac = position - float(index);

    xs.Pu_Scat = getCrossSection(index, frac, 0);
    xs.Pu_Cap  = getCrossSection(index, frac, 1);
    xs.Pu_Fiss = getCrossSection(index, frac, 2);
    xs.U_Scat  = getCrossSection(index, frac, 3);
    xs.U_Cap   = getCrossSection(index, frac, 4);
    xs.U_Fiss  = getCrossSection(index, frac, 5);
    xs.C_Scat  = getCrossSection(index, frac, 6);
    xs.Total = xs.Pu_Fiss + xs.Pu_Cap + xs.Pu_Scat + xs.U_Fiss + xs.U_Cap + xs.U_Scat + xs.C_Scat;

    return xs;
}

uint pcg(inout uint state){
    state = state * 747796405u + 2891336453u;

    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;

    return (word >> 22u) ^ word;
}

float randomFloat(inout uint state){
    return float(pcg(state)) * (1.0 / 4294967296.0); // Valid [0,1)
}

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.neutronCount) return;

    uint rngState = i ^ params.seed;

    const float nu_U = 0.0f;
    const float nu_Pu = 2.88f;

    Neutron neutron = Neutron(
        (1.0f - randomFloat(rngState)) * (ENERGY_MAX - ENERGY_MIN) + ENERGY_MIN,
        1.0f
    );

    CrossSections xs;
    float k_accumulation = 0.0f;
    float energy_min = 0.0f;

    while (true) {
        xs = interpolateCrossSections(neutron);
        k_accumulation += neutron.weight * (xs.U_Fiss * nu_U + xs.Pu_Fiss * nu_Pu) / xs.Total;

        float scatter = randomFloat(rngState) * (xs.Pu_Scat + xs.U_Scat + xs.C_Scat);
        if (scatter < xs.Pu_Scat) {
            const float Pu_alpha = pow(238.0f / 240.0f, 2.0);
            energy_min = Pu_alpha * neutron.energy;
        } else if (scatter < xs.U_Scat + xs.Pu_Scat) {
            const float U_alpha = pow(237.0f / 239.0f, 2.0);
            energy_min = U_alpha * neutron.energy;
        } else {
            const float C_alpha = pow(11.0f / 13.0f, 2.0);
            energy_min = C_alpha * neutron.energy;
        }

        neutron.energy = randomFloat(rngState) * (neutron.energy - energy_min) + energy_min;
        neutron.weight *= (xs.C_Scat + xs.U_Scat + xs.Pu_Scat) / xs.Total;

        if (neutron.weight <= params.rouletteThreshold){
            if (randomFloat(rngState) > params.rouletteLiveRate){
                // Kill neutron
                Tally.data[i] = k_accumulation;
                return;
            }
            // Condense weight
            neutron.weight /= params.rouletteLiveRate;
        }
    }
}
